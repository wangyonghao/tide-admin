{
  "name": "tide-admin",
  "version": "5.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -F @tide/admin run dev",
    "dev:admin": "pnpm -F @tide/admin run dev",
    "build": "pnpm -F @tide/admin run build",
    "build:admin": "pnpm -F @tide/admin run build",
    "build:analyze": "pnpm -F @tide/admin run build:analyze",
    "preview": "pnpm -F @tide/admin run preview",
    "typecheck": "pnpm -F @tide/admin run typecheck",
    "lint": "pnpm oxlint && pnpm eslint . --cache",
    "format": "pnpm oxfmt && pnpm oxlint --fix && pnpm eslint . --cache --fix && pnpm stylelint \"**/*.{vue,css,scss}\" --fix --allow-empty-input",
    "clean": "node ./scripts/clean.mjs",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "dev:docs": "pnpm -F @tide/docs run dev",
    "build:docs": "pnpm -F @tide/docs run build",
    "dev:ds": "pnpm -F @tide/design-system run dev",
    "build:ds": "pnpm -F @tide/design-system run build",
    "test:unit": "vitest run --dom",
    "check": "pnpm run typecheck && pnpm run lint",
    "bootstrap": "pnpm install",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || pnpm exec lefthook install"
  },
  "devDependencies": {
