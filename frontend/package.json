{
  "name": "tide-admin",
  "version": "5.7.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/ui/badge/variant": "@tide/ui/badge/variant",
    "#/ui/checkbox/group": "@tide/ui/checkbox/group",
    "#/ui/date-picker/date-value": "@tide/ui/date-picker/date-value",
    "#/ui-patterns/*": "@tide/ui-patterns/*",
    "#/ui/*": "@tide/ui/*",
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm vite --mode development",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --mode production",
    "build:analyze": "pnpm vite build --mode analyze",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "lint": "pnpm oxlint && pnpm eslint . --cache",
    "format": "pnpm oxfmt && pnpm oxlint --fix && pnpm eslint . --cache --fix && pnpm stylelint \"**/*.{vue,css,scss}\" --fix --allow-empty-input",
    "clean": "node ./scripts/clean.mjs",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "dev:docs": "pnpm -F @tide/docs run dev",
    "build:docs": "pnpm -F @tide/docs run build",
    "test:unit": "vitest run --dom",
    "check": "pnpm run typecheck && pnpm run lint",
    "bootstrap": "pnpm install",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || pnpm exec lefthook install"
  },
  "dependencies": {
    "@intlify/core-base": "catalog:",
