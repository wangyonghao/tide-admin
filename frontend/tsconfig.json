{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "composite": false,
    "target": "ESNext",
    "moduleDetection": "force",
    "experimentalDecorators": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "inlineSources": false,
    "noEmit": true,
    "removeComments": true,
    "sourceMap": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "preserveWatchOutput": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "types": ["vite/client"],
    "declaration": false,
    "paths": {
      "#/*": ["./src/*"],
      "@vben/tailwind-config/theme": ["./src/styles/theme.css"],
      "@vben/tailwind-config": ["./src/styles/theme.css"],
      "@vben/styles/naive": ["./src/vben/styles/naive/index.css"],
      "@vben/styles/global": ["./src/vben/styles/global/index.scss"],
      "@vben/styles": ["./src/vben/styles/index.ts"],
      "@vben/plugins/echarts": ["./src/vben/plugins/echarts/index.ts"],
      "@vben/plugins/tiptap": ["./src/vben/plugins/tiptap/index.ts"],
      "@vben/plugins/vxe-table": ["./src/vben/plugins/vxe-table/index.ts"],
      "@vben/plugins/motion": ["./src/vben/plugins/motion/index.ts"],
      "@vben/plugins": ["./src/vben/plugins/index.ts"],
      "@vben/common-ui/es/tippy": [
        "./src/vben/common-ui/components/tippy/index.ts"
      ],
      "@vben/common-ui/es/loading": [
        "./src/vben/common-ui/components/loading/index.ts"
      ],
      "@vben/common-ui": ["./src/vben/common-ui/index.ts"],
      "@vben/types/global": ["./src/vben/types/global.d.ts"],
      "@vben/types": ["./src/vben/types/index.ts"],
      "@vben/constants": ["./src/vben/constants/index.ts"],
      "@vben/utils": ["./src/vben/utils/index.ts"],
      "@vben/icons": ["./src/vben/icons/index.ts"],
      "@vben/stores": ["./src/vben/stores/index.ts"],
      "@vben/preferences": ["./src/vben/preferences/index.ts"],
      "@vben/locales": ["./src/vben/locales/index.ts"],
      "@vben/request": ["./src/vben/request/index.ts"],
      "@vben/hooks": ["./src/vben/hooks/index.ts"],
      "@vben/layouts": ["./src/vben/layouts/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/vben/types/global.d.ts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
