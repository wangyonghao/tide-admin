############
# wyh-admin — 本地 Docker Compose 环境变量
#
# YOU MUST CHANGE ALL THE DEFAULT SECRET VALUES BELOW BEFORE STARTING
# THE CONTAINERS FOR THE FIRST TIME!
#
# 用法（在 backend/docker 目录）：
#   cp .env.example .env
#   # 编辑 .env，把下面标成占位符的密码和 AES_KEY 换成自己生成的值
#   docker compose --env-file .env -f docker-compose.dev.yml up
#
# 这一条会启动 Postgres、Redis、Inbucket、MinIO、Spring Boot API 和 Vite。
#
# .env 已被 gitignore，不要提交。本示例里的密码不能当作真实口令。
#
# 生成密码（写进 .env，不要写回本文件）：
#   openssl rand -hex 24
# MinIO 根密码至少 8 位。优先用 hex，避免空格和引号进 shell。
# AES_KEY 必须是 16、24 或 32 字节（UTF-8），例如 openssl rand -hex 16（32 字节）。
############

# 容器时区
TZ=Asia/Shanghai

############
# Postgres
# 库名、用户保持 postgres。
############
POSTGRES_USER=postgres
# YOU MUST CHANGE. 生成：openssl rand -hex 24
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Redis
# REDIS_PORT 是宿主机映射。API 在 compose 网络里连 redis:6379，不读这个端口。
############
# YOU MUST CHANGE. 生成：openssl rand -hex 24
REDIS_PWD=your-super-secret-and-long-redis-password
REDIS_PORT=6379
REDIS_DB=15

############
# MinIO（S3）
# 容器内 API 9000 / Console 9001。
# 宿主机 9000 是 Inbucket，所以 API 发布到 9002，控制台仍是 9001。
# API 容器默认用下面的根账号连 http://minio:9000，不必再抄一份密钥。
############
MINIO_ROOT_USER=tide-minio
# YOU MUST CHANGE. 至少 8 位。生成：openssl rand -hex 24
MINIO_ROOT_PASSWORD=your-super-secret-and-long-minio-password
MINIO_BUCKET=tide
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001

############
# Spring Boot API（compose 服务名 api）
# DB_* / REDIS_HOST 是容器网络里的地址，不要写成 localhost。
# DB_PWD 使用 POSTGRES_PASSWORD，不在这里重复。
# AES_KEY：application.crypto.aes-key，启动必填，16/24/32 字节。
# WYH_JWT_SECRET：application-dev.yml 的 sa-token.jwt-secret-key，启动必填。
# YOU MUST CHANGE.
############
AES_KEY=change-me-16char
WYH_JWT_SECRET=change-me-jwt-secret
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
REDIS_HOST=redis
# 空库需要 Liquibase。application-dev.yml 已开启，这里再写明。
SPRING_LIQUIBASE_ENABLED=true
# 默认走 compose 里的 MinIO。改成 LOCAL 则文件进卷 api_files（/data/files）。
FILE_STORAGE_TYPE=MINIO
FILE_MINIO_ENDPOINT=http://minio:9000
# 源码变更后容器内 mvn compile + DevTools 重启。改成 false 则要手动 restart api。
API_HOT_RELOAD=true
# 宿主机端口。容器内 API 固定 8000。
API_PORT=8000

############
# 前端 Vite（容器内 @tide/admin）
# VITE_PORT 是宿主机端口，容器内 Vite 固定监听 5888。
# VITE_GLOB_API_URL 是容器里 Vite 代理的目标，指向 compose 网络中的 api，
# 不是浏览器地址。浏览器仍访问 http://localhost:5888 ，请求走 /api 代理。
############
VITE_PORT=5888
VITE_GLOB_API_URL=http://api:8000
