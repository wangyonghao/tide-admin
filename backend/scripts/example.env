#!/usr/bin/env bash
# Tide Admin — 后端环境变量示例（与 tide-bootstrap/src/main/resources/config 中 ${VAR} 对应）
#
# 用法：
#   cp scripts/env.example.sh scripts/env.sh   # 按需改值；env.sh 勿提交
#   set -a && source scripts/env.sh && set +a
#   mvn -pl tide-bootstrap -am spring-boot:run
#
# IDEA：Run Configuration → Environment variables 填入同名变量。

# --- 应用加密（application.yml / application-dev.yml：application.crypto.aes-key）---
export AES_KEY='your-16-or-32-byte-key!!'

# --- 数据源（application-dev.yml / application-prod.yml：spring.datasource）---
export DB_HOST='localhost'
export DB_PORT='5432'
export DB_NAME='wyhao_admin'
export DB_USER='postgres'
export DB_PWD='postgres@2026'

# --- Redis（application-dev.yml / application-prod.yml：spring.data.redis）---
export REDIS_HOST='127.0.0.1'
export REDIS_PORT='6379'
export REDIS_PWD='redis@2026'
# 开发常用 15；生产示例见下方 prod 段
export REDIS_DB='15'

# --- 邮件 SMTP（application-dev.yml：spring.mail；本地 Inbucket）---
export MAIL_HOST='127.0.0.1'
export MAIL_PORT='2500'
export MAIL_USERNAME='noreply@localhost'
export MAIL_PASSWORD=''

# --- 生产专用密钥（application-prod.yml；本地 dev 可留空）---
# export WYH_JWT_SECRET='change-me'
# export WYH_FIELD_ENCRYPT_PASSWORD='change-me-16chars'
# export WYH_RSA_PUBLIC_KEY=''
# export WYH_RSA_PRIVATE_KEY=''
# export REDIS_DB='0'
